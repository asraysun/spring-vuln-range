<?xml version="1.0" encoding="UTF-8"?>
<!-- m08-crypto-tls: checklist section 8 (cryptography and TLS). Intentionally vulnerable. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.vulnrange</groupId>
    <artifactId>spring-vuln-range</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>m08-crypto-tls</artifactId>
  <name>m08-crypto-tls</name>
  <description>Checklist 8: MD5 hashing, AES/ECB and static-IV CBC, java.util.Random tokens, hardcoded keys, trust-all TrustManager and hostname-verifier bypass; AEAD + SecureRandom + default TLS trust as the fix</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
