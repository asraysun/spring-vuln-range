<?xml version="1.0" encoding="UTF-8"?>
<!-- m12-actuator: checklist section 12 (management endpoints, API docs, debug surfaces). Intentionally vulnerable. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.vulnrange</groupId>
    <artifactId>spring-vuln-range</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>m12-actuator</artifactId>
  <name>m12-actuator</name>
  <description>Checklist 12: unauthenticated /env, /heapdump, /configprops, /loggers, /threaddump, exposed API description, verbose health details; hardened profile with a separate management port and default-deny</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
