<?xml version="1.0" encoding="UTF-8"?>
<!-- m14-runtime-hardening: checklist section 14 (runtime, container, Kubernetes). Intentionally vulnerable. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.vulnrange</groupId>
    <artifactId>spring-vuln-range</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>m14-runtime-hardening</artifactId>
  <name>m14-runtime-hardening</name>
  <description>Checklist 14: runtime disclosure of the container/OS context, writable filesystem, secrets in env; bad vs hardened Kubernetes manifests plus a manifest audit script</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
