<?xml version="1.0" encoding="UTF-8"?>
<!-- m06-deserialization: checklist section 6 (deserialization, XML, polymorphic JSON). Intentionally vulnerable. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.vulnrange</groupId>
    <artifactId>spring-vuln-range</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>m06-deserialization</artifactId>
  <name>m06-deserialization</name>
  <description>Checklist 6: Java deserialization of untrusted bytes, XXE, XStream without type permissions, Jackson polymorphic typing; mitigations via ObjectInputFilter and allow-lists</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.thoughtworks.xstream</groupId>
      <artifactId>xstream</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
